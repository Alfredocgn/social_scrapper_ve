APIFY_TOKEN=
APIFY_ACTOR_ID=shu8hvrXbJbY3Eb9W
APIFY_INPUT_JSON={"directUrls":["https://www.instagram.com/explore/tags/terremoto/","https://www.instagram.com/explore/tags/sismo/","https://www.instagram.com/explore/tags/venezuela/"],"resultsType":"posts","resultsLimit":50}

POLL_SECONDS=120
DATABASE_PATH=data/social_scraper.sqlite3
HOST=127.0.0.1
PORT=8000

# Dashboard y tendencias
UI_REFRESH_SECONDS=15
TREND_WINDOW_HOURS=24
TREND_HALF_LIFE_HOURS=6

# Análisis de pedidos de ayuda con IA (genérico, compatible con OpenAI).
# Si LLM_API_KEY está vacío, el análisis queda inactivo.
# LLM_BASE_URL se infiere por el prefijo de la llave; defínelo para algo no estándar.
# Ejemplos de LLM_MODEL: anthropic/claude-opus-4-8, openai/gpt-4o, meta-llama/llama-3.3-70b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=anthropic/claude-opus-4-8
ANALYZE_LIMIT=20

# Fuente opcional de reels CON vistas reales (ya registrada en apify.py).
# Usa el actor apify/instagram-reel-scraper, que scrapea por CUENTA o URL de
# reel (no por hashtag). Define una lista curada de cuentas y descomenta:
# REELS_TOKEN=
# REELS_ACTOR_ID=apify/instagram-reel-scraper
# REELS_INPUT_JSON={"username":["cuenta_medio_1","cuenta_alerta_2"],"resultsLimit":20}
